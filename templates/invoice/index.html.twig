<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Facture No {{ order.id }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-white">
    <div class="container my-5 p-4 border rounded">
        <!-- Invoice Title -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Facture No {{ order.id }}</h1>
            
        </div>

        <!-- Order date -->
        <p><strong>Date:</strong> {{ order.createdAt | date('d/m/Y') }}</p>

        <!-- Client information-->
        <div class="mb-4">
            <h5>Adresse de Livraison</h5>
            <p>{{ order.delivery | raw }}</p>
        </div>

        <!-- Delivery information -->
        <div class="mb-4">
            <h5>Shop / Carrier</h5>
            <p>
                {% if order.carrier %}
                    {{ order.carrier }}
                {% else %}
                    {{ order.shop }}
                {% endif %}
            </p>
        </div>

        <!-- Order table -->
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th scope="col">Produit</th>
                    
                    <th scope="col">Prix</th>
                    <th scope="col">Quantité</th>
                    <th scope="col">Total</th>
                </tr>
            </thead>
            <tbody>
                {% set totalQuantity = 0 %}
                {% set totalPrice = 0 %}
                {% for product in order.orderDetails %}
                    <tr>
                        <td>{{ product.productName }}</td>
                        
                        <td>{{ '%.2f' | format(product.productPrice) }} €</td>
                        <td>{{ product.productQuantity }}</td>
                        <td>{{ '%.2f' | format(product.productQuantity * product.productPrice) }} €</td>
                        {% set totalQuantity = totalQuantity + product.productQuantity %}
                        {% set totalPrice = totalPrice + (product.productQuantity * product.productPrice) %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <!-- Total -->
        <div class="text-end mt-4">
            <p><strong>Coût du Transport:</strong> {{ '%.2f' | format(order.carrierPrice) }} €</p>
            <p><strong>Total Produits:</strong> {{ '%.2f' | format(totalPrice) }} €</p>
            <p><strong>Total Quantité:</strong> {{ totalQuantity }}</p>
            <h3><strong>Total Facture:</strong> {{ '%.2f' | format(totalPrice + order.carrierPrice) }} €</h3>
        </div>

        
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
