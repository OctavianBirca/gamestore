
<!doctype html>
<html lang="fr" data-bs-theme="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gamestore</title>
    <meta name="description" content="La boutique spécialisée dans la fabrication Made In France">

    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="{{asset ('assets/css/bootstrap.min.css')}}" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Custom styles for this template -->
    <link href="{{asset ('assets/css/carousel.css')}}" rel="stylesheet">
    <link href="{{asset ('assets/css/custom.css')}}" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://kit.fontawesome.com/25104199c2.js" crossorigin="anonymous"></script>

    
</head>
<body class="content d-flex flex-column vh-100">

<header data-bs-theme="dark">
    <nav class="navbar navbar-expand-md navbar-dark fixed-top bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">
                <img src="{{ asset('assets/img/gamestore-logo.svg') }}" alt="Gamestore Logo" width="56" height="45">
                Gamestore
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"> </span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid me-1"></i>Categories
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                            <li><a href="{{ path('app_all_products') }}" class="dropdown-item">Tous les jeux</a></li>
                            {% for category in allCategories %}
                                <li><a class="dropdown-item" href="{{ path('app_category', {slug:category.slug}) }}">{{category.name}}</a></li>
                            {% endfor %}
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-shop me-1"></i>Nos Magasins
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                            {% for store in allStores %}
                                <li>
                                    <a class="dropdown-item" href="{{ path ('app_shop', {slug:store.slug}) }}"> <i class="bi bi-geo-alt-fill me-1"></i> {{store.city}}</a> 
                                   
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                    
                    
                </ul>
                <div class="d-flex align-items-center">
                    
                    {% if app.user %}
                        <a href="{{ path('app_cart') }}" class="btn btn-outline-light me-3 position-relative">
                            <i class="bi bi-cart3"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                {{ fullCartQuantity }}
                            </span>
                        </a>   
                        {% else %}
                               
                        {% endif %}
                    
                    
                    
                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        {% if app.user %}
                            <i class="bi bi-person-circle me-1"></i>{{ app.user.firstname }}
                        {% else %}
                            <i class="bi bi-person-circle me-1"></i>Mon Compte
                        {% endif %}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% if app.user %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="dropdown-item" href="{{ path('admin') }}"><i class="bi bi-person-fill-gear me-2"></i>Administration</a></li>
                                {% endif %}
                                <li><a class="dropdown-item" href="{{path ('app_account') }}"><i class="bi bi-cart-check me-2"></i>Mes commandes</a></li>
                                <li><a class="dropdown-item" href="{{path ('app_account_wishlist') }}"><i class="bi bi-bag-heart me-2"></i>Wishlist</a></li>
                               
                                <li><a class="dropdown-item" href="{{ path('_logout_main') }}"><i class="bi bi-box-arrow-right me-2"></i>Deconnexion</a></li>
                            {% else %}
                                <li><a class="dropdown-item" href="{{ path('app_login') }}"><i class="bi bi-box-arrow-in-right me-2"></i>Connexion</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_register')}}"><i class="bi bi-person-plus me-2"></i>Inscription</a></li>
                            {% endif %}
                            
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    
</header>

<main >
    <div class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mt-5 alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
    {% block body %} {% endblock %}

    
    
</main>

<!-- Footer -->

<footer class="bg-dark text-light py-4 mt-auto">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <h5>Gamestore</h5>
                <p class="text">Votre boutique de jeux vidéo de confiance depuis 2024.</p>
            </div>
            <div class="col-md-4">
                <h5>Nos Magasins</h5>
                <ul class="list-unstyled">
                    {% for store in allStores %}
                        <li> <a  href="{{store.slug}}"> <i class="bi bi-geo-alt-fill me-1"></i> {{store.city}}</a></li>
                    {% endfor %}
                    
                </ul>
            </div>
            <div class="col-md-4">
                <h5>Contact</h5>
                <ul class="list-unstyled">
                    <li><i class="bi bi-envelope me-2"></i>contact@gamestore.fr</li>
                    <li><i class="bi bi-telephone me-2"></i>01 23 45 67 89</li>
                </ul>
            </div>
        </div>
    </div>
</footer>




{% block javascripts %}
<script src="{{asset ('assets/js/bootstrap.bundle.min.js')}}"></script>
<script src="{{asset ('assets/js/global.js')}}"></script> 
{% endblock %}
</body>
</html>
