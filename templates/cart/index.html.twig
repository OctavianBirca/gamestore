{% extends 'base.html.twig' %}


{% block body %}


<div class="container my-5">
    <div class="row">
        <div class="col-md-2">
            {% include 'account/_menu.html.twig' %}
        </div>
        <div class="col-md-10">
            Cart items 
        
            {% for product in cart %} 
                <div class="card mb-3" style=" overflow: hidden;">
                    <div class="row g-0 h-100">
                        <div class="col-5 col-sm-4">
                            <div class="h-100 w-100 overflow-hidden">
                                <img src="/uploads/{{product.object.image}}" class="img-fluid h-100 w-auto" alt="image {{ product.object.name}}">
                            </div>
                        </div>
                        <div class="col-7 col-sm-8">
                            <div class="card-body d-flex flex-column justify-content-between h-100">
                                <h5 class="card-title">{{ product.object.name}}</h5>
                                <div class="row">
                                    <div class="col-4 card-text text-end">Price: {{product.object.price|priceEuro}}</div>
                                    <p class="col-3 card-text text-end"><a href="{{ path('app_cart_decrease',{id:product.object.id})}}" >-<a/> x{{product.qty}} <a href="{{ path('app_cart_add',{id:product.object.id})}}" class="add-to-cart-button" >+<a/></p>
                                    <p class="col-3 card-text text-end"><strong>Total: {{(product.qty * product.object.price) |priceEuro }} </strong></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            {% endfor %}     

            

            <div class="row">
                <div class="col-3">
                    <a href="{{path('app_cart_remove')}}" class="btn btn-danger" >Vider le panier</a>
                </div>
                <div class="col-3">
                    Total produit <span class="badge bg-dark p-2">{{fullCartQuantity}}</span >
                </div>

                <div class="col-3">
                    Prix total <span class="badge bg-dark p-2">{{totalSum|priceEuro}}</span >
                </div>

                <div class="col-3">
                    <a href="{{path('app_order')}}" class="btn btn-success" >Commander</a>
                    <a href="{{path('app_booking')}}" class="btn btn-success" >Reserver</a>
                </div>
            
            </div>
        </div>
    </div>
    
</div>

<script src="{{ path('fos_js_routing_js') }}"></script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
    $('.add-to-cart-button').on('click', function(e) {
        e.preventDefault(); // Previne comportamentul implicit de redirecționare.

        var productId = $(this).data('product-id');
        var quantity = 1;

        $.ajax({
            url: Routing.generate('app_cart_add', { id: productId }), // Folosește funcția Routing pentru Symfony.
            type: 'POST',
            data: {
                product_id: productId,
                quantity: quantity
            },
            success: function(response) {
                if (response.status === 'success') {
                    alert(response.message);
                    // Actualizează numărul de produse din coș sau afișează alte informații necesare.
                    $('#cart-count').text(parseInt($('#cart-count').text()) + quantity);
                    $('#cart-total-sum').text(response.cartTotal + " €"); // Exemplu pentru actualizarea sumei totale.
                }
            },
            error: function() {
                alert('A apărut o eroare. Te rugăm să încerci din nou.');
            }
        });
    });
});


</script>

{% endblock %}
