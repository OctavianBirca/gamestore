{% extends 'base.html.twig' %}


{% block body %}


<div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            {% include 'account/_menu.html.twig' %}
        </div>
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Ma Commande No {{ order.id }}</h5>
                    <div>
                        {{ include('admin/state.html.twig', {field : {'value' : order.state}}) }}
                        <a href="{{ path('app_invoice', {id_order : order.id}) }}" class="btn btn-light btn-sm ms-2">Facture</a>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted">Passée le {{ order.createdAt|date('d/m/Y') }}</p>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card border-light mb-3">
                                <div class="card-body">
                                    <h5 class="card-title">Adresse</h5>
                                    <p class="card-text">{{ order.delivery|raw }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-light mb-3">
                                <div class="card-body">
                                    <h5 class="card-title">Magasin</h5>
                                    <p class="card-text">
                                        
                                            {{ order.shop }} </br>
                                            {{order.shop.address}} </br> 
                                            {{order.shop.postalCode}}</br>
                                            {{order.shop.city}}</br>
                                    
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr>
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Produit</th>
                                <th scope="col">Image</th>
                                <th scope="col">Prix</th>
                                <th scope="col">Quantité</th>
                                <th scope="col">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set totalQuantity = 0 %}
                            {% set totalPrice = 0 %}
                            {% for product in order.orderDetails %}
                                <tr>
                                    <td>{{ product.productName }}</td>
                                    <td><img src="/uploads/{{ product.productImage }}" alt="{{ product.productName }}" class="img-thumbnail" style="max-width: 100px;" /></td>
                                    <td>{{ product.productPrice|priceEuro }}</td>
                                    <td>{{ product.productQuantity }}</td>
                                    <td>{{ (product.productQuantity * product.productPrice)|priceEuro }}</td>
                                    {% set totalQuantity = totalQuantity + product.productQuantity %}
                                    {% set totalPrice = totalPrice + (product.productQuantity * product.productPrice) %}
                                </tr>
                            {% endfor %}
                            
                            <tr class="fw-bold">
                                <td colspan="2"></td>
                                <td>Total : {{ totalPrice|priceEuro }}</td>
                                <td>Total Quantité : {{ totalQuantity }}</td>
                                <td>Total Final : {{ totalPrice|priceEuro }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



{% endblock %}
