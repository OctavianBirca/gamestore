{% extends 'base.html.twig' %}


{% block body %}


<div class="container my-5">
    <div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            {% include 'account/_menu.html.twig' %}
        </div>
        <div class="col-md-9">
            <h1>Mon compte</h1>
            <h2>Ma liste de souhaite</h2>
            {% if app.user.wishlists|length > 0 %}
                <div class="row">
                    {% for product in app.user.wishlists %}
                        {% include 'product/card.index.twig' %}
                    {% endfor %}
                </div>
            {% else %}
                Vous n'avez pas des produits dans votre liste de souhaite.
            {% endif %}
                        
        </div>
    </div>
    
</div>
    </br>

    
</div>
{% endblock %}
