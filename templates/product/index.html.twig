{% extends 'base.html.twig' %}

{% block body %}

<div class="container my-5">
    <div class="row g-4">
        
        <div class="col-md-4">
            <img class="img-fluid rounded shadow-sm" src="/uploads/{{ product.image }}" alt="Image {{ product.name }}">
        </div>        

        <!-- details -->
        <div class="col-md-8">
            <!-- Category -->
            <div class="mb-3">
                <div class="btn-group">
                    {% for category in product.categories %}
                        <a href="{{ path('app_category', { slug: category.slug }) }}" class="btn btn-outline-primary">
                            {{ category.name }}
                        </a>
                    {% endfor %}
                    <span class="btn btn-outline-secondary active" aria-current="page">{{ product.name }}</span>
                </div>
            </div>

            <!-- title and description -->
            <h1 class="mb-3">{{ product.name }}</h1>
            <p class="text-muted">{{ product.description | raw }}</p>

            <!-- price -->
            <span class="badge bg-dark display-6 py-2 px-4">{{ product.price | priceEuro }}</span>

            <!-- add button -->
            <div class="mt-4">
                <a href="{{ path('app_cart_add', { id: product.id }) }}" class="btn btn-success btn-lg">
                    <i class="fa-solid fa-cart-plus"></i> Ajouter au panier
                </a>
            </div>

            <!-- Wishlist -->
            <div class="mt-4">
                {% if app.user %}
                    {% if product in app.user.wishlists %}
                        <a href="{{ path('app_account_wishlist_remove', { id: product.id }) }}" class="btn btn-danger btn-lg">
                            <i class="fa-solid fa-heart"></i> Retirer de la liste de souhaits
                        </a>
                    {% else %}
                        <a href="{{ path('app_account_wishlist_add', { id: product.id }) }}" class="btn btn-danger btn-lg">
                            <i class="fa-regular fa-heart"></i> Ajouter à la liste de souhaits
                        </a>
                    {% endif %}
                {% else %}
                    <a data-bs-toggle="collapse" href="#collapseWishlistAlert" role="button" aria-expanded="false" aria-controls="collapseWishlistAlert" class="btn btn-danger btn-lg">
                        <i class="fa-solid fa-heart"></i> Ajouter à la liste de souhaits
                    </a>
                {% endif %}

                <!-- message for non connected user for wishlist -->
                <div class="collapse mt-2" id="collapseWishlistAlert">
                    <div class="alert alert-warning">
                        Pour sauvegarder un produit, <a href="{{ path('app_login') }}">connectez-vous</a> ou <a href="{{ path('app_register') }}">créez votre compte</a>.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
