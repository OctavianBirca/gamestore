{% extends 'base.html.twig' %}

{% block title %}Hello OrderController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper my-5">
    <h1>Ma commande</h1>

        
    <ul>
        
        {{form_start(orderForm)}}
            {{ form_row(orderForm.addresses)}}
                <a href="{{path('app_account_address_form')}}" class="btn btn-primary">Ajouter une adresse</a>
            {{ form_row(orderForm.shop) }}
            
            {{ form_row(orderForm.pickup_date) }}
            {{ form_row(orderForm.submit) }}
        {{form_end(orderForm)}}
       
    </ul>
</div>




{% endblock %}

{% block javascripts %}
<script src="{{asset ('assets/js/bootstrap.bundle.min.js')}}"></script>
<script src="{{asset ('assets/js/global.js')}}"></script> 
<script src="{{asset ('assets/js/pickup-store.js')}}"></script> 
<script src="{{asset ('assets/js/booking-calendar.js')}}"></script> 


{% endblock %}