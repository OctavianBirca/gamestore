{% extends 'base.html.twig' %}

{% block title %}Hello OrderController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper my-5">
    <h1>Ma commande</h1>

        
    <ul>
        
        {{form_start(bookingForm)}}
            {{ form_row(bookingForm.addresses)}}
                <a href="{{path('app_account_address_form')}}" class="btn btn-primary">Ajouter une adresse</a>
            {{ form_row(bookingForm.shop) }}
            
            {{ form_row(bookingForm.pickup_date) }}
            {{ form_row(bookingForm.submit) }}
        {{form_end(bookingForm)}}
       
    </ul>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        const pickupDateInput = document.querySelector('.pickup-date');
        
        // Calculate the minimum and maximum dates
        const currentDate = new Date();
        const minDate = new Date(currentDate);
        minDate.setDate(currentDate.getDate() + 1); // Minimum one day in the future

        const maxDate = new Date(currentDate);
        maxDate.setDate(currentDate.getDate() + 7); // Maximiun 7 in the future

        // Setting the min and max arrtibutes of the input
        pickupDateInput.min = minDate.toISOString().split('T')[0];
        pickupDateInput.max = maxDate.toISOString().split('T')[0];

        // Event listner for the change event
        pickupDateInput.addEventListener('change', function () {
            const selectedDate = new Date(pickupDateInput.value);
            const dayOfWeek = selectedDate.getDay(); // 0 = Sunday, 1 = Monday

            // Verifying if the selected date is a Sunday or Monday
            if (dayOfWeek === 0 || dayOfWeek === 1) {
                alert('Les agences sont fermées le lundi et le dimanche. Veuillez choisir une autre date.');
                pickupDateInput.value = ''; // Reset the value
            }
        });
    });
</script>

<script>
        document.addEventListener("DOMContentLoaded", function () {
            // Cities and departments codes
            const cities = [
                { name: "Paris", postalCodes: [60, 75, 77, 78, 91, 92, 93, 94, 95, 08, 10, 51, 52, 54, 55, 57, 67, 68, 88, 21, 25, 39, 58, 70, 71, 89, 90, 18, 28, 36, 37, 41, 45, 14, 27, 61, 76] },
                { name: "Bordeaux", postalCodes: [16, 17, 19, 23, 24, 33, 40, 47, 64, 79, 86, 87] },
                { name: "Lille", postalCodes: [02, 59, 62, 80] },
                { name: "Nantes", postalCodes: [22, 29, 35, 56, 44, 49, 53, 72, 85, 50] },
                { name: "Toulouse", postalCodes: [09, 11, 12, 30, 31, 32, 34, 46, 48, 65, 66, 81, 82, 04, 05, 06, 13, 83, 84, 01, 03, 07, 15, 26, 38, 42, 43, 63, 69, 73, 74] }
            ];

            // Get the postal code from the element
            const postalSpan = document.querySelector(".postal");
            if (!postalSpan) {
                console.error("Didn't found the element.");
                return;
            }

            // extract the postal code
            const postalCode = postalSpan.textContent.trim();
            const postalPrefix = parseInt(postalCode.substring(0, 2), 10);

            // find the city that corresponds to the postal code
            let foundCity = null;
            for (const city of cities) {
                for (const code of city.postalCodes) {
                    if (code === postalPrefix) {
                        foundCity = city;
                        break;
                    }
                }
                if (foundCity) break;
            }

            if (!foundCity) {
                console.warn("Did not find the city:", postalPrefix);
                return;
            }

            // Dropdown element setup
            const shopSelect = document.querySelector("#booking_shop");
            if (!shopSelect) {
                console.error("Dropdown was not found.");
                return;
            }

            let found = false;
            for (const option of shopSelect.options) {
                if (option.textContent.includes(foundCity.name)) {
                    option.selected = true;
                    found = true;
                    console.log(`selected: ${option.textContent}`);
                    break;
                }
            }

            if (!found) {
                console.warn("Did not found the city:", foundCity.name);
            }
        });
    </script>

{% endblock %}
