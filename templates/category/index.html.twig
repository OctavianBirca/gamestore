{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}


<div class="container my-5">
    <h1>{{ category.name }}</h1>
    
    <div class="row">
                
        {% for product in category.products %}
           {% include 'product/card.index.twig' %}
        {% else %}
            <p>Aucun produit disponible pour cette catégorie.</p>
        {% endfor %} 
        
    </div>
    
</div>
{% endblock %}
